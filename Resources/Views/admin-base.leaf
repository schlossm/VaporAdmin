<!DOCTYPE html>
<html lang=en>
    <head>
        <title>#import("title")</title>
        <meta charset=utf-8>
        <meta name="viewport" content="width=device-width, initial-scale=1 viewport-fit=cover">
        
        <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
        <script src="https://unpkg.com/@popperjs/core@2"></script>
        <script src="/adminTheme.js"></script>
        
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
        
        <meta name="apple-mobile-web-app-title" content="#import("title")">
        <meta name="application-name" content="#import("title")">
        <meta name="theme-color" content="#ffffff">
        
        #import("head-extras")
    </head>
    <body>
        <div class="position-sticky top-0 z-2 bg-body">
            <div class="container-xxl pt-3 mb-0">
                <div class="container-xxl border rounded">
                    <nav class="my-2 mx-0" aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            #for(breadcrumb in header.breadcrumbs):
                                #if(breadcrumb.isActive):
                                <li class="breadcrumb-item active" aria-current="page">#(breadcrumb.text)</li>
                                #else:
                                <li class="breadcrumb-item"><a href="#(breadcrumb.relativeHREF)">#(breadcrumb.text)</a></li>
                                #endif
                            #endfor
                        </ol>
                    </nav>
                </div>
                
                <div class="row mt-3">
                    <h3>Hello, #(header.username)</h3>
                </div>
            </div>
            
            <hr class="solid mt-0">
        </div>
        
        <div class="container-xxl mt-5">
            #import("admin-body")
        </div>
    </body>
</html>
