#extend("admin-base"):
    #export("head-extras"): <script src="/admin/static/adminList.js"></script> #endexport
    #export("title"): Admin / #(modelName) #endexport
    #export("admin-body"):
        <div class="list-group mt-1">
            <div class="list-group-item list-group-item-success pb-0">
                <h4>#(modelName)</h4>
            </div>
            #for(entry in entries):
                <div class="list-group-item">
                    <div class="d-flex flex-wrap column-gap-3 align-items-center align-content-end">
                        <a class="col-auto h-100" href="/admin/models/#(modelName)/details/#(entry.id)">#(entry.text)</a>
                        <p class="col-auto h-auto ms-auto my-auto text-secondary font-monospace">(#(entry.id))</p>
                        <button type="button" class="btn btn-danger col-auto" data-bs-target="#deleteModal" data-bs-toggle="modal" data-bs-modelName="#(modelName)" data-bs-modelID="#(entry.id)" data-bs-modelDisplayName="#(entry.text)">Delete</button>
                    </div>
                </div>
            #endfor
        </div>
        
        <div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="deleteModalLabel">Are you sure?</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                    Do you want to delete this model?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" id="confirmedDelete">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    #endexport
#endextend
